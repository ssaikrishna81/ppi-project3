#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  info [
    "CSCI-style group project world for Perception, Planning and Interactions."
    "Coordinates: x/y on floor plane, z vertical."
  ]
  title "Project 3 - Generative AI Embodied Robot Assistant"
}
Viewpoint {
  orientation -0.5426614995498837 0.5637221730811975 0.6226843570243945 1.9633756970626945
  position 3.1487815525193104 -5.042270380613978 27.09025399624825
}
Background {
  skyColor [
    0.92 0.95 1
  ]
}
DirectionalLight {
  ambientIntensity 0.45
  direction -0.4 0.3 -1
  intensity 1.2
}
DEF FLOOR Solid {
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.82 0.84 0.82
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 10 8 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 10 8 0.1
  }
}
# Visual office carpet layer.
# It intentionally has no boundingObject, so robot-floor physics remain unchanged.
DEF OFFICE_CARPET Transform {
  translation 0 0 0.002
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 1 1
        baseColorMap ImageTexture {
          url [
            "carpet_texture.png"
          ]
          filtering 4
        }
        roughness 1
        metalness 0
      }
      geometry Box {
        size 9.76 7.76 0.004
      }
    }
  ]
}

